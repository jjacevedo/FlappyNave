// Game.jack
// Controlador principal del juego Flappy Nave
// Gestiona el loop, input, colisiones, puntaje y dificultad
// No conoce detalles internos de Nave ni Tuberia

class Game {
    field Board board;
    field Nave nave;
    field Tuberia tuberia1;
    field Tuberia tuberia2;
    field Tuberia tuberia3;
    field boolean exit;
    field int delay;
    field int frameCount;
    field int gracia;

    constructor Game new() {
        // velocidad inicial de tuberias
        do Tuberia.setVel(2);

        // crear tablero
        let board = Board.new();

        // crear nave centrada horizontalmente, parte superior
        let nave = Nave.new(250, 15);

        // crear 3 tuberias escalonadas en distintas posiciones
        // x distintos para que no esten alineadas
        // yPos inicial escalonado para que entren de a poco
        let tuberia1 = Tuberia.new(60,  35, 60);
        let tuberia2 = Tuberia.new(230, 55, 140);
        let tuberia3 = Tuberia.new(390, 25, 210);

        let delay = 16;
        let frameCount = 0;
        let gracia = 45;

        do dibujarEscena();
        return this;
    }

    // Redibujar tablero, tuberias y nave
    method void dibujarEscena() {
        do board.draw();
        do tuberia1.draw();
        do tuberia2.draw();
        do tuberia3.draw();
        do nave.draw();
        return;
    }

    method void dispose() {
        do board.dispose();
        do nave.dispose();
        do tuberia1.dispose();
        do tuberia2.dispose();
        do tuberia3.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // Manejar input del teclado
    method void handleInput(char key) {
        if (key = 130) {                     // flecha izquierda
            do nave.moveLeft();
            do nave.boost();
        }
        if (key = 132) {                     // flecha derecha
            do nave.moveRight();
            do nave.boost();
        }
        if (key = 131) { do nave.boost(); } // flecha arriba
        return;
    }

    // Verificar colisiones
    method boolean verificarColisiones() {
        if (gracia > 0) { return false; }

        if (tuberia1.colision(nave.getX(), nave.getY())) { return true; }
        if (tuberia2.colision(nave.getX(), nave.getY())) { return true; }
        if (tuberia3.colision(nave.getX(), nave.getY())) { return true; }

        // colision con bordes
        if (nave.getY() > 235) { return true; }
        if (nave.getY() < 3)   { return true; }

        return false;
    }

    // Verificar si alguna tuberia paso — sumar punto
    method void verificarPuntos() {
        if (tuberia1.pasada(nave.getY())) { do board.sumarPunto(); }
        if (tuberia2.pasada(nave.getY())) { do board.sumarPunto(); }
        if (tuberia3.pasada(nave.getY())) { do board.sumarPunto(); }
        return;
    }

    // Aumentar dificultad cada 10 puntos
    method void actualizarDificultad() {
        var int pts;
        var int nuevaVel;
        let pts = board.getPuntaje();

        // velocidad sube cada 10 puntos, maximo 6
        if (pts < 10)  { let nuevaVel = 2; }
        if ((pts > 9)  & (pts < 20)) { let nuevaVel = 3; }
        if ((pts > 19) & (pts < 30)) { let nuevaVel = 4; }
        if ((pts > 29) & (pts < 40)) { let nuevaVel = 5; }
        if (pts > 39)  { let nuevaVel = 6; }

        do Tuberia.setVel(nuevaVel);
        return;
    }

    // Actualizar todos los objetos
    method void update() {
        do nave.update();

        if (gracia > 0) {
            let gracia = gracia - 1;
        } else {
            do tuberia1.update();
            do tuberia2.update();
            do tuberia3.update();
            do verificarPuntos();
            do actualizarDificultad();
        }

        let frameCount = frameCount + 1;
        return;
    }

    // Pantalla de inicio
    method void pantallaInicio() {
        do Screen.clearScreen();
        do Output.moveCursor(5, 18);
        do Output.printString("FLAPPY NAVE");
        do Output.moveCursor(8, 10);
        do Output.printString("Esquiva las tuberias que bajan");
        do Output.moveCursor(10, 10);
        do Output.printString("Flecha izq/der: mover y subir");
        do Output.moveCursor(11, 10);
        do Output.printString("Flecha arriba: subir");
        do Output.moveCursor(12, 10);
        do Output.printString("Q: salir");
        do Output.moveCursor(14, 10);
        do Output.printString("Presiona cualquier tecla...");

        // esperar tecla y soltarla
        while (Keyboard.keyPressed() = 0) {}
        while (~(Keyboard.keyPressed() = 0)) {}

        do Screen.clearScreen();
        do dibujarEscena();
        return;
    }

    // Pantalla de game over
    method void pantallaGameOver() {
        do Screen.clearScreen();
        do Output.moveCursor(5, 17);
        do Output.printString("GAME  OVER");
        do Output.moveCursor(8, 14);
        do Output.printString("Puntaje: ");
        do Output.printInt(board.getPuntaje());
        do Output.moveCursor(10, 14);
        do Output.printString("Record:  ");
        do Output.printInt(board.getHighScore());
        do Output.moveCursor(13, 10);
        do Output.printString("R: reiniciar    Q: salir");
        return;
    }

    // Reiniciar el juego para nueva partida
    method void reiniciar() {
        do Tuberia.setVel(2);
        do board.resetPuntaje();
        do board.draw();

        do nave.erase();
        do nave.reset(250, 15);
        do nave.draw();

        do tuberia1.reset(60,  35, 60);
        do tuberia2.reset(230, 55, 140);
        do tuberia3.reset(390, 25, 210);

        do dibujarEscena();
        let frameCount = 0;
        let gracia = 45;
        return;
    }

    // Loop principal del juego
    method void run() {
        var char key;
        var boolean colision;
        var boolean jugando;

        do pantallaInicio();
        let jugando = true;

        while (jugando) {
            // reset estado
            let colision = false;
            let exit = false;

            // loop de juego
            while (~exit) {
                let key = Keyboard.keyPressed();

                if (key = 81) { let exit = true; } // Q salir

                do handleInput(key);
                do update();

                let colision = verificarColisiones();
                if (colision) { let exit = true; }

                do Sys.wait(delay);
            }

            // si salio con Q terminar todo
            if (key = 81) {
                let jugando = false;
            } else {
                // game over — esperar decision
                do pantallaGameOver();

                let exit = false;
                while (~exit) {
                    let key = Keyboard.keyPressed();
                    if (key = 81) {          // Q salir
                        let exit = true;
                        let jugando = false;
                    }
                    if (key = 82) {          // R reiniciar
                        let exit = true;
                        do reiniciar();
                    }
                }
            }
        }

        return;
    }
}
