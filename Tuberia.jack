// Tuberia.jack
// Representa una tuberia que baja desde arriba
// Ancho variable, baja a velocidad compartida
// Se regenera sola cuando sale por la parte inferior
// Game solo llama update(), colision(), pasada()

class Tuberia {
    static int vel;    // velocidad compartida por todas las tuberias
    field int xPos;    // posicion horizontal
    field int yPos;    // posicion vertical
    field int ancho;   // ancho variable de la tuberia
    field int alto;    // alto fijo de la tuberia
    field boolean activa;
    field boolean contada; // para saber si ya sumo punto

    // Inicializar velocidad global
    function void setVel(int v) {
        let vel = v;
        return;
    }

    function int getVel() {
        return vel;
    }

    constructor Tuberia new(int x, int anch, int yInicial) {
        let xPos = x;
        let ancho = anch;
        let yPos = yInicial;
        let alto = 18;
        let activa = true;
        let contada = false;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    // Dibujar tuberia
    method void draw() {
        if (~activa) { return; }
        if (yPos < 3) { return; }
        if ((yPos + alto) > 252) { return; }
        do Screen.setColor(true);
        do Screen.drawRectangle(xPos, yPos, xPos + ancho, yPos + alto);
        return;
    }

    // Borrar tuberia
    method void erase() {
        var int yFin;
        if (yPos < 3) { return; }
        // fuera del area de juego: nada que borrar (evita y1 > y2)
        if (yPos > 252) { return; }
        do Screen.setColor(false);
        let yFin = yPos + alto + vel;
        if (yFin > 252) {
            let yFin = 252;
        }
        do Screen.drawRectangle(xPos, yPos, xPos + ancho, yFin);
        return;
    }

    // Actualizar posicion — bajar y regenerar si sale
    method void update() {
        if (~activa) { return; }

        do erase();
        let yPos = yPos + vel;

        // regenerar antes de quedar con coordenadas invalidas
        if ((yPos > 255) | ((yPos + alto) > 252)) {
            do regenerar();
        } else {
            do draw();
        }
        return;
    }

    // Regenerar tuberia desde arriba con nuevo ancho
    method void regenerar() {
        // ancho variable entre 20 y 80 segun posicion actual de x
        // usamos xPos como "semilla" para variar el ancho
        let yPos = 0;
        let contada = false;

        // variar ancho usando modulo simulado
        if (xPos < 150) {
            let ancho = 35;
        }
        if ((xPos > 149) & (xPos < 300)) {
            let ancho = 55;
        }
        if (xPos > 299) {
            let ancho = 25;
        }
        return;
    }

    // Verificar colision con la nave
    // nave ocupa aprox 11px ancho x 15px alto
    method boolean colision(int nx, int ny) {
        if (~activa) { return false; }
        if (yPos < 3) { return false; }

        if ((nx < (xPos + ancho)) & ((nx + 11) > xPos)) {
            if ((ny < (yPos + alto)) & ((ny + 15) > yPos)) {
                return true;
            }
        }
        return false;
    }

    // Verificar si la tuberia ya paso la nave (para sumar punto)
    method boolean pasada(int ny) {
        if (contada) { return false; }
        if (yPos > (ny + 15)) {
            let contada = true;
            return true;
        }
        return false;
    }

    // Getters
    method int getX() { return xPos; }
    method int getY() { return yPos; }
    method boolean estaActiva() { return activa; }

    // Reset completo
    method void reset(int x, int anch, int yInicial) {
        let xPos = x;
        let ancho = anch;
        let yPos = yInicial;
        let activa = true;
        let contada = false;
        return;
    }
}
